    {
      "id": "714-0004-code-filter",
      "name": "未投稿記事を選出",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "jsCode": "// WP公開記事リスト取得（配列 or 分割アイテム両対応）\nconst wpItems = $('WP公開記事取得').all();\nlet posts = [];\nif (wpItems.length === 1 && Array.isArray(wpItems[0].json)) {\n  posts = wpItems[0].json;\n} else {\n  posts = wpItems.map(i => i.json).filter(p => p && p.id);\n}\n\n// 投稿済みpost_id一覧（Sheetsから）\nconst logItems = $input.all();\nconst postedIds = new Set(\n  logItems\n    .map(i => i.json.post_id)\n    .filter(Boolean)\n    .map(String)\n);\n\n// 古い順で最初の未投稿記事を1件選出\nconst unposted = posts.find(p => p && p.id && !postedIds.has(String(p.id)));\n\nif (!unposted) {\n  return [{ json: { proceed: false } }];\n}\n\n// HTMLタグ除去・エンティティ変換\nconst stripHtml = (str) => (str || '')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&#[0-9]+;/g, '')\n  .replace(/\\n+/g, ' ')\n  .trim();\n\nconst title = stripHtml((unposted.title || {}).rendered);\nconst excerpt = stripHtml((unposted.excerpt || {}).rendered).slice(0, 120);\n\nreturn [{\n  json: {\n    proceed: true,\n    post_id: String(unposted.id),\n    post_date: unposted.date,\n    title,\n    excerpt,\n    url: unposted.link\n  }\n}];"
      }
    },
    {
      "id": "714-0005-if",
      "name": "IF 未投稿あり",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.proceed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "714-0006-build-text",
      "name": "投稿文を生成",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 180],
      "parameters": {
        "jsCode": "const { title, excerpt, url } = $json;\n\nconst base = `📖 ${title}\\n\\n${excerpt}\\n\\n▼ 続きを読む\\n${url}`;\n\nlet text = base;\nif (text.length > 480) {\n  const maxEx = 480 - `📖 ${title}\\n\\n…\\n\\n▼ 続きを読む\\n${url}`.length;\n  const short = excerpt.slice(0, Math.max(0, maxEx)) + '…';\n  text = `📖 ${title}\\n\\n${short}\\n\\n▼ 続きを読む\\n${url}`;\n}\n\nreturn [{ json: { ...$json, text } }];"
      }
    },
