      "parameters": {
        "jsCode": "// Sheets書き込み系ノード（continueOnFail）のエラーを検査し、あればSlack通知用メッセージを返す\nconst v = $('Verify & Build Post Row').first().json;\nconst checks = [\n  ['Append posts', 'posts追記'],\n  ['Append posted_items', 'posted_items追記'],\n  ['Update post_queue (posted)', 'post_queue更新']\n];\nconst fails = [];\nfor (const [nodeName, label] of checks) {\n  try {\n    const out = $(nodeName).first().json;\n    if (out && out.error) fails.push(`${label}: ${JSON.stringify(out.error).slice(0, 150)}`);\n  } catch (e) {\n    fails.push(`${label}: ノード未実行/出力なし`);\n  }\n}\nif (!fails.length) return [];\nreturn [{ json: { message: `⚠️ DEV_RIO_705B Sheets書込エラー（投稿自体は成功: ${v.post_id} / ${v.thread_id}）\\n` + fails.join('\\n') } }];"
