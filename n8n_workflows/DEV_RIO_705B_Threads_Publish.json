    {
      "parameters": {
        "jsCode": "// 投稿成否を判定し、成功時は posts 行を組み立てる\nconst sel = $('Select Post').first().json;\nlet created = null;\ntry { created = $('Threads Create Media').first().json; } catch (e) {}\nlet pub = null;\ntry { pub = $input.first().json; } catch (e) {}\nconst createOk = created && created.id && !created.error;\nconst pubOk = pub && pub.id && !pub.error;\nif (!createOk || !pubOk) {\n  const detail = JSON.stringify((pub && pub.error) || (created && created.error) || pub || created || {}).slice(0, 300);\n  return [{ json: { ok: false, post_id: sel.post_id, status: 'failed', message: `⚠️ DEV_RIO_705B 投稿失敗 slot${sel.slot} ${sel.itemCode || ''}\\n${detail}` } }];\n}\nconst jstNow = new Date(Date.now() + 9 * 3600000);\nconst formats = { 1: 'morning_problem', 2: 'noon_specs', 3: 'night_story' };\nreturn [{ json: {\n  ok: true,\n  post_id: sel.post_id,\n  thread_id: pub.id,\n  posted_at: jstNow.toISOString().replace('Z', '+09:00'),\n  slot: sel.slot,\n  itemCode: sel.itemCode,\n  shopCode: sel.shopCode || '',\n  category: sel.category,\n  format: formats[Number(sel.slot)] || '',\n  tracking_id: sel.tracking_id\n} }];"
      },
