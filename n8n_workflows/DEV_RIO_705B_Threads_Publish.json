    {
      "parameters": {
        "jsCode": "// 当日分の status=ready を全slotから横断し、finalScoreが最も高い1件を選ぶ。\n// 705B自体は1日1回のみ起動(2026-08-19改定: 3回起動のうち2回は日次上限で必ず空振りだったため統合)。\n// 705Aは引き続き1日3ジャンル分(gadget/stationery, supplement/food_gift, bag_wallet/book)を候補として積むが、\n// 実際に投稿するのはその中の最高スコア1件のみ。選ばれなかった同日分は投稿後にskipped_daily_limitへ更新する。\nconst ctx = $('Detect Slot (JST)').first().json;\nconst today = ctx.today;\nlet queue = [];\ntry { queue = $('Read post_queue').all().map(i => i.json).filter(r => r && r.itemCode); } catch (e) {}\nlet posts = [];\ntry { posts = $('Read posts').all().map(i => i.json).filter(r => r && r.thread_id); } catch (e) {}\n\nconst byRecency = queue.filter(r => String(r.status) === 'failed' || String(r.status) === 'posted')\n  .sort((a, b) => (String(b.date) + String(b.slot).padStart(2, '0')).localeCompare(String(a.date) + String(a.slot).padStart(2, '0')));\nlet consecFail = 0;\nfor (const r of byRecency) { if (String(r.status) === 'failed') consecFail++; else break; }\nif (consecFail >= 3) {\n  return [{ json: { proceed: false, reason: 'consecutive_failures_stop', today, consecFail } }];\n}\n\nconst todayPosts = posts.filter(r => String(r.posted_at || '').slice(0, 10) === today);\nif (todayPosts.length >= 1) {\n  return [{ json: { proceed: false, reason: 'daily_limit_reached', today } }];\n}\n\nconst candidates = queue.filter(r => String(r.date) === today && String(r.status) === 'ready');\nif (!candidates.length) {\n  return [{ json: { proceed: false, reason: 'no_ready_post', today } }];\n}\ncandidates.sort((a, b) => Number(b.finalScore || 0) - Number(a.finalScore || 0));\nconst cand = candidates[0];\nconst siblingPostIds = candidates.slice(1).map(r => r.post_id);\nreturn [{ json: { ...cand, proceed: true, today, siblingPostIds } }];"
      },
