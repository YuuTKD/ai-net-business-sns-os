    {
      "parameters": {
        "jsCode": "// JSTの曜日から今日の業種カテゴリを決定\n// 月:飲食 火:飲食 水:美容 木:飲食 金:美容 土:整体 日:飲食 → 週に飲食4・美容2・整体1\nconst jstNow = new Date(Date.now() + 9 * 3600000);\nconst dow = jstNow.getUTCDay(); // +9h済み → getUTCDayでJSTの曜日(0=日)\nconst map = { 0: '飲食', 1: '飲食', 2: '飲食', 3: '美容', 4: '飲食', 5: '美容', 6: '整体' };\nconst category = map[dow];\nconst today = jstNow.toISOString().slice(0, 10);\nreturn [{ json: { category, today, dow } }];"
      },
      "id": "713b-0002-detect-cat",
      "name": "Detect Category (JST DOW)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1180,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1ZpufySbgfVGqdPkDbrRnuHsDcX6k2JDkGq1Bw-6nHv4",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "store_goods_pool",
          "mode": "name"
        },
        "options": {}
      },
      "id": "713b-0003-read-pool",
      "name": "Read store_goods_pool",
      "alwaysOutputData": true,
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -960,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "3MvBU36ZMU4wtaoc",
          "name": "Google Sheets account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// 今日の業種カテゴリ × status=ready の候補を抽出し、date_added最古順に並べる（最大3件を再試行用に保持）\nconst ctx = $('Detect Category (JST DOW)').first().json;\nlet rows = [];\ntry { rows = $('Read store_goods_pool').all().map(i => i.json).filter(r => r && r.item_name); } catch (e) {}\nconst candidates = rows\n  .filter(r => String(r.category) === ctx.category && String(r.status) === 'ready')\n  .sort((a, b) => String(a.date_added || '').localeCompare(String(b.date_added || '')));\nif (!candidates.length) {\n  return [{ json: { proceed: false, reason: 'no_ready_goods', category: ctx.category, today: ctx.today } }];\n}\n// 上位3件を再試行候補として保持。post_idが空の行はrow_number等で更新できないため、item_name+date_addedをキーにして後段で照合する。\nconst picks = candidates.slice(0, 3).map(c => ({\n  item_name: c.item_name,\n  price: c.price,\n  url: c.url || '',\n  affiliate_url: c.affiliate_url || c.url || '',\n  category: c.category,\n  description: c.description || '',\n  source: c.source || '',\n  date_added: c.date_added || '',\n  post_id: c.post_id || ''\n}));\nreturn [{ json: { proceed: true, category: ctx.category, today: ctx.today, picks } }];"
      },
      "id": "713b-0004-select",
      "name": "Select Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.proceed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "713b-0005-if-proceed",
      "name": "IF Has Candidates",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -520,
        300
