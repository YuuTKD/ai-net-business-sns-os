    {
      "parameters": {
        "jsCode": "// AI生成文をパースし、コンプラチェックを通過した最初の1件を選ぶ（最大3候補を順に検査）\nconst payload = $('Prepare Copy Prompt').first().json;\nconst picks = payload.picks || [];\nconst texts = {};\ntry {\n  const res = $input.first().json;\n  const raw = (res && res.content && res.content[0] && res.content[0].text) ? res.content[0].text : '';\n  const m = raw.match(/\\[[\\s\\S]*\\]/);\n  const arr = JSON.parse(m ? m[0] : raw);\n  for (const a of arr) texts[Number(a.idx)] = String(a.text || '');\n} catch (e) { /* パース失敗 → 全件textなし扱い */ }\n\nconst yakki = /治る|治療|効く|効果がある|改善する|予防|痩せる|若返る|病気|症状|医療/;\nconst kodai = /必ず|絶対|確実に/;\nconst urlRe = /https?:\\/\\//;\n\nlet chosen = null;\nlet chosenText = '';\nconst skipped = [];\nfor (let i = 0; i < picks.length; i++) {\n  const t = String(texts[i] || '').trim();\n  const name = picks[i].item_name;\n  if (!t) { skipped.push(`${name}: 生成文なし`); continue; }\n  if (t.length > 480) { skipped.push(`${name}: 480字超`); continue; }\n  if (yakki.test(t)) { skipped.push(`${name}: 薬機法NGワード`); continue; }\n  if (kodai.test(t)) { skipped.push(`${name}: 断定・保証表現`); continue; }\n  if (urlRe.test(t)) { skipped.push(`${name}: URL含む`); continue; }\n  chosen = picks[i];\n  chosenText = t;\n  break;\n}\n\nif (!chosen) {\n  return [{ json: { proceed: false, reason: 'all_skipped', category: payload.category, today: payload.today, skipped } }];\n}\nreturn [{ json: {\n  proceed: true,\n  category: payload.category,\n  today: payload.today,\n  text: chosenText,\n  item_name: chosen.item_name,\n  price: chosen.price,\n  affiliate_url: chosen.affiliate_url || chosen.url || '',\n  source: chosen.source,\n  date_added: chosen.date_added,\n  post_id: chosen.post_id,\n  skipped\n} }];"
      },
