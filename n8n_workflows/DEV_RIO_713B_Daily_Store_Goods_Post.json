    {
      "parameters": {
        "jsCode": "// 投稿成否を判定。成功時はpool更新行(status=posted)を組み立て、コメント投稿用にthread_id/URLも保持\nconst sel = $('Parse & Compliance Gate').first().json;\nlet created = null;\ntry { created = $('Threads Create Media').first().json; } catch (e) {}\nlet pub = null;\ntry { pub = $input.first().json; } catch (e) {}\nconst createOk = created && created.id && !created.error;\nconst pubOk = pub && pub.id && !pub.error;\nconst jstNow = new Date(Date.now() + 9 * 3600000);\nconst postedAt = jstNow.toISOString().replace('Z', '+09:00');\nif (!createOk || !pubOk) {\n  const detail = JSON.stringify((pub && pub.error) || (created && created.error) || pub || created || {}).slice(0, 300);\n  return [{ json: {\n    ok: false,\n    item_name: sel.item_name,\n    date_added: sel.date_added,\n    post_id: sel.post_id || '',\n    status: 'failed',\n    posted_at: postedAt,\n    message: `⚠️ DEV_RIO_713B Threads投稿失敗 [${sel.category}] ${sel.item_name}\\n${detail}`\n  } }];\n}\nreturn [{ json: {\n  ok: true,\n  item_name: sel.item_name,\n  date_added: sel.date_added,\n  post_id: pub.id,\n  status: 'posted',\n  posted_at: postedAt,\n  thread_id: pub.id,\n  category: sel.category,\n  affiliate_url: sel.affiliate_url || '',\n  message: `✅ DEV_RIO_713B 投稿完了 [${sel.category}] ${sel.item_name}\\nthread_id: ${pub.id}`\n} }];"
